@using Bastilia.Rating.Domain

@if (Project.Slug is null)
{
    <a href="/project/@Project.BastiliaProjectId">@Project.ProjectName</a>
}
else
{
    <a href="/project/@Project.Slug">@Project.ProjectName</a>
}
@if (AdminProjectIds?.Contains(Project.BastiliaProjectId) == true)
{
    <a href="/admin/project/@Project.BastiliaProjectId" title="Управление проектом" class="ms-1">
        <JoinIcon Icon="JoinIconType.Edit" />
    </a>
}



@code
{
    [Parameter, EditorRequired]
    public IBastiliaProjectLink Project { get; set; } = null!;

    [CascadingParameter]
    private HashSet<int>? AdminProjectIds { get; set; }
}