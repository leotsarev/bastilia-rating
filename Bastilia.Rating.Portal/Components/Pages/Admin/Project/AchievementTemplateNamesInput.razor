<div>
    <label>
        Уровень проекта:
        <InputSelect TValue="ProjectLevel" Value="ProjectLevel" ValueChanged="OnProjectLevelChanged" ValueExpression="() => ProjectLevel" class="form-select">
            <option value="@ProjectLevel.XS">XS</option>
            <option value="@ProjectLevel.S">S</option>
            <option value="@ProjectLevel.M">M</option>
            <option value="@ProjectLevel.L">L</option>
        </InputSelect>
    </label>
</div>
<div class="alert alert-info">@ProjectLevel.GetSizeDescription()</div>
@{ var ratingValues = ProjectLevel.GetAchievementRatingValues(); }
@for (var i = 0; i < ratingValues.Count; i++)
{
    var index = i;
    <div class="border rounded p-3 mb-3">
        <div class="fw-bold mb-2">Ачивка за @Bastilia.Rating.Portal.Client.CountHelper.DisplayCount(ratingValues[index], "балл", "балла", "баллов")</div>
        <div class="mb-2">
            <label>
                Название:
                <InputText @bind-Value="Templates[index].Name" class="form-control" />
            </label>
        </div>
        <div>
            <label>
                Описание:
                <InputTextArea @bind-Value="Templates[index].Description" class="form-control" />
            </label>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ProjectLevel ProjectLevel { get; set; }

    [Parameter]
    public EventCallback<ProjectLevel> ProjectLevelChanged { get; set; }

    [Parameter, EditorRequired]
    public AchievementTemplateInput[] Templates { get; set; } = [];

    [Parameter]
    public EventCallback<AchievementTemplateInput[]> TemplatesChanged { get; set; }

    private async Task OnProjectLevelChanged(ProjectLevel newLevel)
    {
        ProjectLevel = newLevel;
        Templates = AchievementTemplateInputHelper.CreateDefaults(newLevel);
        await TemplatesChanged.InvokeAsync(Templates);
        await ProjectLevelChanged.InvokeAsync(newLevel);
    }
}
