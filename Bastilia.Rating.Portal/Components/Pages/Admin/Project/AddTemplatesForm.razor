@inject IProjectService projectService
@inject NavigationManager navigationManager

<Card>
    <Header>Добавить шаблоны ачивок</Header>
    <Body>
        <EditForm FormName="AddTemplatesForm" Model="Model" OnValidSubmit="Complete">
            <AchievementTemplateNamesInput @bind-ProjectLevel="Model!.ProjectLevel" @bind-Templates="Model!.Templates" />
            @if (error is not null)
            {
                <Alert>@error</Alert>
            }
            <div>
                <input type="submit" value="Добавить шаблоны" class="btn btn-danger" />
            </div>
        </EditForm>
    </Body>
</Card>

@code {
    [Parameter, EditorRequired]
    public BastiliaProjectId ProjectId { get; set; } = null!;

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [SupplyParameterFromForm]
    private AddTemplatesViewModel? Model { get; set; }

    private string? error;

    protected override void OnInitialized()
    {
        Model ??= new AddTemplatesViewModel();
        base.OnInitialized();
    }

    private async Task Complete()
    {
        if (Model!.Templates.Any(t => string.IsNullOrWhiteSpace(t.Name)))
        {
            error = "Заполните название для каждой ачивки уровня";
            return;
        }
        error = null;

        await projectService.AddAchievementTemplates(ProjectId, Model.ProjectLevel, Model.Templates);
        await OnCompleted.InvokeAsync();
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private class AddTemplatesViewModel
    {
        public ProjectLevel ProjectLevel { get; set; } = ProjectLevel.XS;
        public AchievementTemplateInput[] Templates { get; set; } = AchievementTemplateInputHelper.CreateDefaults(ProjectLevel.XS);
    }
}
