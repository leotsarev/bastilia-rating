@inject IProjectService projectService
@inject NavigationManager navigationManager

<Card>
    <Header>Завершить проект</Header>
    <Body>
        <EditForm FormName="CompleteProjectForm" Model="Model" OnValidSubmit="Complete">
            <div>
                <label>
                    Дата окончания проекта:
                    <InputDate @bind-Value="Model!.EndDate" class="form-control" />
                </label>
            </div>
            <AchievementTemplateNamesInput @bind-ProjectLevel="Model!.ProjectLevel" @bind-Templates="Model!.Templates" />
            @if (error is not null)
            {
                <Alert>@error</Alert>
            }
            <div>
                <input type="submit" value="Завершить проект" class="btn btn-danger" />
            </div>
        </EditForm>
    </Body>
</Card>

@code {
    [Parameter, EditorRequired]
    public BastiliaProjectId ProjectId { get; set; } = null!;

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [SupplyParameterFromForm]
    private CompleteViewModel? Model { get; set; }

    private string? error;

    protected override void OnInitialized()
    {
        Model ??= new CompleteViewModel();
        base.OnInitialized();
    }

    private async Task Complete()
    {
        if (Model!.Templates.Any(t => string.IsNullOrWhiteSpace(t.Name)))
        {
            error = "Заполните название для каждой ачивки уровня";
            return;
        }
        error = null;

        await projectService.CompleteProject(ProjectId, Model.EndDate, Model.ProjectLevel, Model.Templates);
        await OnCompleted.InvokeAsync();
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private class CompleteViewModel
    {
        public DateOnly EndDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public ProjectLevel ProjectLevel { get; set; } = ProjectLevel.XS;
        public AchievementTemplateInput[] Templates { get; set; } = AchievementTemplateInputHelper.CreateDefaults(ProjectLevel.XS);
    }
}
