@page "/admin/project/{ProjectId}"
@using Bastilia.Rating.Portal.Client.Components.Projects
@using Bastilia.Rating.Portal.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject ProjectNavigateHelper projectNavigateHelper
@inject IAchievementService achievementService
@inject IAchievementGrantedNotifier achievementNotifier
@inject UserLoaderHelper userLoaderHelper

<PageTitle>Админка проекта @project?.ProjectName</PageTitle>

@if (project is null)
{
    <LoadingSpinner />
    return;
}
<ProjectCard Project="project" />

@if (addedSuccess)
{
    <Alert>Успешно добавлена ачивка</Alert>
}

@if (project.ProjectMemberAchievements.Count == 0 && project.EndDate is not null)
{
    <Alert>Здесь нет ни одной ачивки. Скорее всего данные об этом проекте еще восстанавливаются с архивов.</Alert>
}

<JoinCollapsePanelGroup>
    @if (project.Templates.Count > 0)
    {
        <JoinCollapsePanel Open="true">
            <Header>Добавление ачивки</Header>
            <ChildContent>
                <EditForm FormName="AddAchievemntForm" Model="AddModel" OnValidSubmit="Add">
                    <div>
                        <MultiUserInput @key="addFormResetKey" Label="Пользователь:" @bind-Value="AddModel!.UserId" />
                    </div>
                    <div>
                        <label>
                            Ачивка:
                            <InputSelect @bind-Value="AddModel!.TemplateId" class="form-select">
                                @foreach (var template in project.Templates)
                                {
                                    <option value="@template.TemplateId">@template.Name</option>
                                }
                            </InputSelect>
                        </label>
                    </div>
                    <div>
                        <JoinButton Submit Preset="ButtonPreset.Add" />
                    </div>
                </EditForm>
            </ChildContent>
        </JoinCollapsePanel>
    }

    @if (project.Templates.Count > 0)
    {
        <JoinCollapsePanel>
            <Header>Шаблоны ачивок проекта</Header>
            <ChildContent>
                @foreach (var template in project.Templates)
                {
                    <EditTemplateForm Template="template" OnCompleted="ReloadProject" />
                }
            </ChildContent>
        </JoinCollapsePanel>
    }

    @if (project.EndDate is null && project.ProjectMemberAchievements.Count == 0 && isPresident)
    {
        <CompleteProjectForm ProjectId="project.BastiliaProjectId" OnCompleted="ReloadProject" />
    }
    @if (project.EndDate is not null && project.ProjectLevel is not null)
    {
        <AddTemplatesForm ProjectId="project.BastiliaProjectId" ProjectLevel="project.ProjectLevel.Value" OnCompleted="ReloadProject" />
    }

    @if (isPresident)
    {
        <SetProjectLevelForm ProjectId="project.BastiliaProjectId" CurrentLevel="project.ProjectLevel" OnCompleted="ReloadProject" />
    }

    <EditCoordinatorsForm ProjectId="project.BastiliaProjectId" Coordinators="project.Coordinators" OnCompleted="ReloadProject" />
</JoinCollapsePanelGroup>

@code {
    [Parameter]
    public string? ProjectId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromForm]
    private AddViewModel? AddModel { get; set; }

    private BastiliaProjectWithDetails? project;
    private bool addedSuccess = false;
    private bool isPresident = false;
    private int currentUserId;
    private int addFormResetKey;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateTask!;
        var user = authState.User;
        currentUserId = user.GetJoinrpgUserId();
        isPresident = user.IsInRole(BastiliaRoles.President);

        project = await projectNavigateHelper.LoadProjectForAdmin(ProjectId!, user);
    }

    protected override void OnInitialized()
    {
        AddModel ??= new AddViewModel();
        AddModel.UserId ??= [];
        base.OnInitialized();
    }

    private async Task Add()
    {
        addedSuccess = false;
        var authState = await AuthenticationStateTask!;
        project = await projectNavigateHelper.LoadProjectForAdmin(ProjectId!, authState.User);
        if (project != null)
        {
            var users = await userLoaderHelper.LoadUsersWithCheck(AddModel!.UserId);
            foreach (var user in users)
            {
                await achievementService.GrantAchivement(project.BastiliaProjectId, user.JoinrpgUserId, AddModel.TemplateId, currentUserId, null);
                var template = project.Templates.Single(t => t.TemplateId == AddModel.TemplateId);
                await achievementNotifier.NotifyAchievementGrantedAsync(user, template, project.ProjectName, project.Slug ?? project.BastiliaProjectId.ToString());
            }
            addedSuccess = true;
        }
        project = await projectNavigateHelper.LoadProjectForAdmin(ProjectId!, authState.User);
        AddModel = new AddViewModel();
        addFormResetKey++;
    }

    private class AddViewModel
    {
        public string[] UserId { get; set; } = [];
        public int TemplateId { get; set; }
    }

    private async Task ReloadProject()
    {
        var authState = await AuthenticationStateTask!;
        project = await projectNavigateHelper.LoadProjectForAdmin(ProjectId!, authState.User);
    }
}
