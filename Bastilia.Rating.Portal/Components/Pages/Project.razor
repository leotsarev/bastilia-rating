@page "/project/{projectId}"
@using Bastilia.Rating.Portal.Client.Components.Achievements
@using Bastilia.Rating.Portal.Client.Components.BastiliaUsers
@using Bastilia.Rating.Portal.Client.Components.Projects
@using Bastilia.Rating.Portal.Auth
@using Bastilia.Rating.Portal.Common.Telegram
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid

@inject ProjectNavigateHelper projectNavigateHelper
@inject IProjectNewsRepository newsRepository
@inject NewsHtmlRenderer newsHtmlRenderer
<PageTitle>Проект @project?.ProjectName</PageTitle>
@if (project is null)
{
    <LoadingSpinner />
    return;
}
<ProjectCard Project="project" ShowAdminLink="isAdmin" />

@if (lastNews is not null)
{
    <Card>
        <Header>Новости</Header>
        <Body>
            <div class="text-muted small">@lastNews.CreatedAt.ToLocalTime().ToString("g") — @lastNews.AuthorName</div>
            <div>@((MarkupString)newsHtmlRenderer.RenderMarkdownToTelegramHtml(lastNews.Text))</div>
            <a href="/project/@ProjectId/news">Все новости →</a>
        </Body>
    </Card>
}
else if (isAdmin)
{
    <p><a href="/project/@ProjectId/news">Все новости →</a> Напишите первую новость проекта!</p>
}

@if (project.ProjectMemberAchievements.Count > 0)
{
    <AchievementList Project="project" />
}
else if (project.EndDate is not null)
{
    <Alert>Здесь нет ни одной ачивки. Скорее всего данные об этом проекте еще восстанавливаются с архивов.</Alert>
}

@code {
    [Parameter]
    public string ProjectId { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private BastiliaProjectWithDetails? project;
    private Bastilia.Rating.Domain.ProjectNews? lastNews;
    private bool isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        project = await projectNavigateHelper.LoadProjectWithCheck(ProjectId);
        if (project is null)
        {
            return;
        }

        var authState = await AuthenticationStateTask!;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            isAdmin = user.IsProjectAdmin(project);
        }

        lastNews = await newsRepository.GetLastForProject(project.BastiliaProjectId);
    }
}
